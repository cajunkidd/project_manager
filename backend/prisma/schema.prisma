// Internal Project Management Application — Prisma schema
// Datasource is SQLite for local/dev/test ergonomics. Swap `provider` to
// "postgresql" and update the URL to migrate to Postgres without code changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String
  passwordHash String
  role         String   @default("user") // admin | manager | user | viewer
  department   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects     Project[]      @relation("ProjectOwner")
  createdProjects   Project[]      @relation("ProjectCreator")
  assignedTasks     Task[]         @relation("TaskAssignee")
  createdTasks      Task[]         @relation("TaskCreator")
  comments          Comment[]
  activityLogs      ActivityLog[]
  notifications     Notification[]
  defaultForForms   Form[]           @relation("FormDefaultAssignee")
  createdForms      Form[]           @relation("FormCreator")
  formSubmissions   FormSubmission[] @relation("FormSubmitter")
  automationRules   AutomationRule[] @relation("AutomationCreator")
  apiTokens         ApiToken[]
  webhooks          WebhookSubscription[]
  projectMemberships ProjectMember[]
  ownedPortfolios     Portfolio[]         @relation("PortfolioOwner")
  createdTemplates    ProjectTemplate[]   @relation("ProjectTemplateCreator")
  createdRecurring    RecurringTaskRule[] @relation("RecurringTaskCreator")
  budgetEntries       BudgetEntry[]
  timeEntries         TimeEntry[]
  requestedApprovals  ApprovalRequest[]   @relation("ApprovalRequester")
  approvedApprovals   ApprovalRequest[]   @relation("ApprovalApprover")
}

model Project {
  id           String    @id @default(uuid())
  name         String
  description  String?
  ownerId      String?
  status       String    @default("not_started") // not_started | active | on_hold | completed | cancelled
  priority     String    @default("normal")      // low | normal | high | urgent
  department   String?
  startDate    DateTime?
  dueDate      DateTime?
  completedAt  DateTime?
  portfolioId  String?
  budgetAmount Float?
  budgetCurrency String? @default("USD")
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner     User?     @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdBy User?     @relation("ProjectCreator", fields: [createdById], references: [id])
  portfolio Portfolio? @relation(fields: [portfolioId], references: [id])
  tasks     Task[]
  comments  Comment[]
  forms     Form[]    @relation("FormDefaultProject")
  members   ProjectMember[]
  budgetEntries BudgetEntry[]
  recurringRules RecurringTaskRule[]

  @@index([status])
  @@index([ownerId])
  @@index([department])
}

model Task {
  id           String    @id @default(uuid())
  projectId    String?
  parentTaskId String?
  title        String
  description  String?
  status       String    @default("to_do") // backlog | to_do | in_progress | waiting | review | done | cancelled
  priority     String    @default("normal")
  assignedToId String?
  createdById  String?
  startDate    DateTime?
  dueDate      DateTime?
  completedAt  DateTime?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask Task?     @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[]    @relation("TaskSubtasks")
  assignedTo      User?            @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy       User?            @relation("TaskCreator", fields: [createdById], references: [id])
  comments        Comment[]
  formSubmissions FormSubmission[] @relation("FormSubmissionTask")
  blockedBy       TaskDependency[] @relation("DependencyBlocked")
  blocking        TaskDependency[] @relation("DependencyBlocker")
  timeEntries     TimeEntry[]

  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String?
  projectId String?
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([projectId])
}

model ActivityLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  oldValue   String?
  newValue   String?
  userId     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  title      String
  message    String
  type       String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model Form {
  id                 String    @id @default(uuid())
  name               String
  description        String?
  defaultProjectId   String?
  defaultAssigneeId  String?
  defaultPriority    String    @default("normal")
  isActive           Boolean   @default(true)
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  defaultProject  Project?         @relation("FormDefaultProject", fields: [defaultProjectId], references: [id])
  defaultAssignee User?            @relation("FormDefaultAssignee", fields: [defaultAssigneeId], references: [id])
  createdBy       User?            @relation("FormCreator", fields: [createdById], references: [id])
  fields          FormField[]
  submissions     FormSubmission[]

  @@index([isActive])
}

model FormField {
  id         String   @id @default(uuid())
  formId     String
  label      String
  fieldType  String // text | textarea | dropdown | checkbox | date | user
  isRequired Boolean  @default(false)
  options    String? // JSON-encoded for dropdown options
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

model FormSubmission {
  id            String   @id @default(uuid())
  formId        String
  submittedById String?
  responseData  String   // JSON-encoded answers keyed by field id
  createdTaskId String?
  createdAt     DateTime @default(now())

  form         Form  @relation(fields: [formId], references: [id], onDelete: Cascade)
  submittedBy  User? @relation("FormSubmitter", fields: [submittedById], references: [id])
  createdTask  Task? @relation("FormSubmissionTask", fields: [createdTaskId], references: [id])

  @@index([formId])
  @@index([submittedById])
}

model AutomationRule {
  id          String   @id @default(uuid())
  name        String
  triggerType String
  conditions  String? // JSON-encoded
  actions     String   // JSON-encoded array
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("AutomationCreator", fields: [createdById], references: [id])

  @@index([triggerType, isActive])
}

model ApiToken {
  id          String    @id @default(uuid())
  name        String
  tokenHash   String    @unique
  prefix      String    // first 8 chars for display
  scopes      String    // comma-separated, e.g. "tasks:write,projects:read"
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([tokenHash])
  @@index([isActive])
}

model WebhookSubscription {
  id          String   @id @default(uuid())
  name        String
  url         String
  secret      String   // shared secret used for HMAC signature
  events      String   // comma-separated event types
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?              @relation(fields: [createdById], references: [id])
  deliveries WebhookDelivery[]

  @@index([isActive])
}

model WebhookDelivery {
  id             String   @id @default(uuid())
  subscriptionId String
  eventType      String
  payload        String   // JSON-encoded body
  status         String   // pending | success | failed
  statusCode     Int?
  responseBody   String?
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("editor") // owner | editor | viewer
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Portfolio {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User?     @relation("PortfolioOwner", fields: [ownerId], references: [id])
  projects Project[]
}

model ProjectTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  payload     String   // JSON: { project: {...defaults...}, tasks: [{...}, ...] }
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation("ProjectTemplateCreator", fields: [createdById], references: [id])
}

model RecurringTaskRule {
  id              String    @id @default(uuid())
  name            String
  projectId       String?
  templateTitle   String
  templateDesc    String?
  templatePriority String   @default("normal")
  assignedToId    String?
  frequency       String    // daily | weekly | monthly
  nextRunAt       DateTime
  isActive        Boolean   @default(true)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastRunAt       DateTime?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("RecurringTaskCreator", fields: [createdById], references: [id])

  @@index([nextRunAt, isActive])
}

model TaskDependency {
  id             String   @id @default(uuid())
  blockedTaskId  String
  blockerTaskId  String
  createdAt      DateTime @default(now())

  blockedTask Task @relation("DependencyBlocked", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  blockerTask Task @relation("DependencyBlocker", fields: [blockerTaskId], references: [id], onDelete: Cascade)

  @@unique([blockedTaskId, blockerTaskId])
  @@index([blockerTaskId])
}

model BudgetEntry {
  id          String   @id @default(uuid())
  projectId   String
  kind        String   // planned | actual
  amount      Float
  description String?
  occurredAt  DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([projectId])
  @@index([kind])
}

model TimeEntry {
  id         String   @id @default(uuid())
  taskId     String
  userId     String
  minutes    Int
  notes      String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
}

model ApprovalRequest {
  id            String    @id @default(uuid())
  entityType    String    // task | project
  entityId      String
  status        String    @default("pending") // pending | approved | rejected | cancelled
  reason        String?
  decisionNote  String?
  targetStatus  String?   // optional new status to apply on approval
  requestedById String
  approverId    String?
  decisionAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requestedBy User  @relation("ApprovalRequester", fields: [requestedById], references: [id])
  approver    User? @relation("ApprovalApprover", fields: [approverId], references: [id])

  @@index([entityType, entityId])
  @@index([status])
}

model EmailLog {
  id        String   @id @default(uuid())
  direction String   // outbound | inbound
  toAddress String?
  fromAddress String?
  subject   String
  body      String
  meta      String?  // JSON-encoded extra info
  createdAt DateTime @default(now())

  @@index([direction])
}
