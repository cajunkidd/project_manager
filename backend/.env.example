DATABASE_URL="postgresql://postgres:password@localhost:5432/project_manager"
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_EXPIRATION="7d"
PORT=3001
ANTHROPIC_API_KEY="sk-ant-..."

# Email (optional). If SMTP_HOST is unset, email sending is disabled.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Project Manager <noreply@example.com>"
APP_URL="http://localhost:5173"

# Shared secret required by /email/inbound. Configure your email provider
# (Mailgun, SendGrid Inbound Parse, Postmark, etc.) to POST normalized
# {from, to, subject, text, html} JSON with this value in X-Inbound-Secret.
INBOUND_EMAIL_SECRET=""

# Daily digest cron (default: 8 AM server time). Standard 5-field crontab.
DIGEST_CRON="0 8 * * *"
