DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_manager?schema=public"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Optional. AI features (project summary, task extraction) require this.
# Risk scoring is heuristic and works without it.
ANTHROPIC_API_KEY=

# Optional. Email notifications (assignment, mention, daily digest) require SMTP.
# Without these set, email sends are skipped and only in-app notifications fire.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Project Manager <noreply@example.com>"
APP_BASE_URL="http://localhost:5173"

# Daily digest hour in 24h server local time. Default 8.
DAILY_DIGEST_HOUR=8
